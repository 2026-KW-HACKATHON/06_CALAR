# 서버 환경변수로 설정하세요. 이 예제에는 실제 비밀번호를 저장하지 마세요.
# backend/.env 로 복사하면 서버 시작 시(db.js, scripts/start-server.cjs) 자동으로 읽습니다.
# 아래 값은 운영 서버(wolgye.kr) 기준입니다. 로컬 개발은 맨 아래 주석을 참고하세요.

# 메일 (이메일 인증·비밀번호 복구)
CALAR_SMTP_HOST=smtp.gmail.com
CALAR_SMTP_PORT=587
CALAR_SMTP_SECURE=false
CALAR_SMTP_USER=rexnamccx1229@gmail.com
CALAR_SMTP_PASSWORD=
CALAR_MAIL_FROM=rexnamccx1229@gmail.com

# 문자 인증 (SOLAPI)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# KakaoPay: fill operational credentials to enable payments
KAKAOPAY_MODE=live
KAKAOPAY_CID=
KAKAOPAY_SECRET_KEY=

# 서버
NODE_ENV=production
HOST=127.0.0.1
PORT=8008
CALAR_PUBLIC_URL=https://wolgye.kr
CALAR_DEV_CREDIT=false
CALAR_SESSION_DAYS=90

# 로컬 개발 시에는 위 서버 항목 대신 아래 값을 쓰세요 (같은 키를 두 번 쓰면 뒤의 값이 적용됩니다)
# NODE_ENV=development
# HOST=0.0.0.0
# CALAR_PUBLIC_URL=http://localhost:5173
# CALAR_DEV_CREDIT=true
# KAKAOPAY_MODE=test
# KAKAOPAY_CID=TC0ONETIME
