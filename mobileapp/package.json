{
  "name": "calar-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "node scripts/configure.mjs && vite build",
    "build:dev": "node scripts/configure.mjs development && vite build --mode development",
    "sync": "npm run build && cap sync",
    "sync:dev": "npm run build:dev && cap sync",
    "android": "npm run sync:dev && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "axios": "^1.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "uuid": "11.1.0"
  }
}
